# Opcional: copia este archivo a ".env" (en esta misma carpeta) SOLO si quieres cambiar algo.
# Sin .env todo funciona con los valores por defecto. NUNCA subas ".env" a git.

# Contraseña del administrador de SQL Server (usuario "sa"). Debe ser fuerte (8+ chars, mayúsc., minúsc., número y símbolo).
MSSQL_SA_PASSWORD=Sima_Dev_2026!

# Contraseña del usuario "sima_api" que usa el backend (evita los caracteres $ y ')
API_DB_PASSWORD=Sima_Api_2026!

# Puerto de la BD en tu computadora (para DBeaver) y de la API
DB_HOST_PORT=14330
API_PORT=3000

# Firma de tokens
JWT_SECRET=sima-dev-secret-cambialo-en-produccion-123456

# Administrador del taller que se crea al iniciar
SEED_ADMIN_EMAIL=taller@sima.mx
SEED_ADMIN_PASSWORD=sima1234

# true = carga clientes, citas y órdenes de ejemplo si la BD está vacía
SEED_DEMO=true
