# Copia este archivo a ".env" y ajusta los valores. NUNCA subas ".env" a git.
PORT=3000

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=SIMADB
DB_USER=sima_api
DB_PASSWORD=Cambia_Esta_Clave_123!
DB_ENCRYPT=false

# Firma de tokens (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Orígenes permitidos para la web (separados por coma). Flutter no necesita CORS.
CORS_ORIGINS=http://localhost:5173

# Datos del administrador que crea "npm run seed"
SEED_ADMIN_EMAIL=taller@sima.mx
SEED_ADMIN_PASSWORD=sima1234

# true = carga clientes, citas y órdenes de ejemplo SOLO si la tabla Usuarios está vacía
SEED_DEMO=true
